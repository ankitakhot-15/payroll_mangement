        && isValidSalaryStructure(incoming())
        && incoming().structureId == existing().structureId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isCompanyOperator(existing().companyOwnerUid, existing().companyId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['basic', 'hra', 'da', 'conveyance', 'medical', 'specialAllowance', 'grossMonthly', 'annualCtc', 'pfApplicable', 'esiApplicable', 'ptApplicable', 'taxRegime', 'effectiveDate', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(structureId) && isCompanyOperator(existing().companyOwnerUid, existing().companyId);
