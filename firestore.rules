        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'latitude', 'longitude', 'radiusMeters', 'allowWfh', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(locationId) && isCompanyOperator(existing().companyOwnerUid, existing().companyId);
