        && isCompanyOperator(existing().companyOwnerUid, existing().companyId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['deviceName', 'serialNumber', 'locationName', 'ipAddress', 'protocol', 'connectionStatus', 'lastSyncAt', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(deviceId) && isCompanyOperator(existing().companyOwnerUid, existing().companyId);
    }

    match /faceRegistrations/{regId} {
      allow get: if isVerifiedUser()
        && isValidId(regId)
        && (
          isCompanyOperator(existing().companyOwnerUid, existing().companyId)
          || existing().employeeUid == request.auth.uid
          || ('employeeEmail' in existing() && existing().employeeEmail == request.auth.token.email)
        );
      allow list: if isVerifiedUser()
        && (
          isWorkspaceOperatorEmail()
          || resource.data.companyOwnerUid == request.auth.uid
          || resource.data.employeeUid == request.auth.uid
          || ('employeeEmail' in resource.data && resource.data.employeeEmail == request.auth.token.email)
        );
      allow create: if isVerifiedUser()
        && isValidId(regId)
        && isValidFaceRegistration(incoming())
        && incoming().registrationId == regId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isCompanyOperator(incoming().companyOwnerUid, incoming().companyId)
          || (incoming().employeeUid == request.auth.uid && incoming().status == 'pending_verification')
        );
      allow update: if isVerifiedUser()
        && isValidId(regId)
        && isValidFaceRegistration(incoming())
        && incoming().registrationId == existing().registrationId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().employeeId == existing().employeeId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isCompanyOperator(existing().companyOwnerUid, existing().companyId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['employeeUid', 'employeeEmail', 'employeeName', 'status', 'consentAccepted', 'sampleCount', 'qualityScore', 'templateDigest', 'referencePhotoDataUrl', 'faceDescriptor', 'reviewNote', 'updatedAt'])
          )
          || (
            (existing().employeeUid == request.auth.uid || ('employeeEmail' in existing() && existing().employeeEmail == request.auth.token.email))
            && incoming().status == 'pending_verification'
            && incoming().diff(existing()).affectedKeys().hasOnly(['employeeUid', 'employeeEmail', 'status', 'consentAccepted', 'sampleCount', 'qualityScore', 'templateDigest', 'referencePhotoDataUrl', 'faceDescriptor', 'updatedAt'])
          )
          || (
            'employeeEmail' in existing()
            && existing().employeeEmail == request.auth.token.email
            && incoming().employeeUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['employeeUid', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(regId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || existing().employeeUid == request.auth.uid);
    }

    match /attendance/{attendanceId} {
      allow get: if isVerifiedUser() && isValidId(attendanceId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || existing().employeeUid == request.auth.uid);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid || resource.data.employeeUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(attendanceId)
        && isValidAttendance(incoming())
        && incoming().attendanceId == attendanceId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isCompanyOperator(incoming().companyOwnerUid, incoming().companyId) || incoming().employeeUid == request.auth.uid);
      allow update: if isVerifiedUser()
        && isValidId(attendanceId)
        && isValidAttendance(incoming())
        && incoming().attendanceId == existing().attendanceId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isCompanyOperator(existing().companyOwnerUid, existing().companyId) && incoming().diff(existing()).affectedKeys().hasOnly(['employeeUid', 'attendanceStatus', 'faceVerification', 'livenessStatus', 'checkInFaceVerification', 'checkInLivenessStatus', 'checkInConfidenceScore', 'checkOutFaceVerification', 'checkOutLivenessStatus', 'checkOutConfidenceScore', 'gpsStatus', 'workingMinutes', 'breakMinutes', 'overtimeMinutes', 'lateMinutes', 'approvalStatus', 'checkInAt', 'checkOutAt', 'updatedAt']))
          || (existing().employeeUid == request.auth.uid && incoming().employeeUid == existing().employeeUid && incoming().diff(existing()).affectedKeys().hasOnly(['attendanceStatus', 'faceVerification', 'livenessStatus', 'checkInFaceVerification', 'checkInLivenessStatus', 'checkInConfidenceScore', 'checkOutFaceVerification', 'checkOutLivenessStatus', 'checkOutConfidenceScore', 'gpsStatus', 'workingMinutes', 'breakMinutes', 'overtimeMinutes', 'lateMinutes', 'checkInAt', 'checkOutAt', 'updatedAt']))
        );
      allow delete: if isCompanyAdminEmail() && isValidId(attendanceId);
    }

    match /attendanceEvents/{eventId} {
      allow get: if isVerifiedUser() && isValidId(eventId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || existing().employeeUid == request.auth.uid);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid || resource.data.employeeUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(eventId)
        && isValidAttendanceEvent(incoming())
        && incoming().eventId == eventId
        && incoming().createdAt == request.time
        && (isCompanyOperator(incoming().companyOwnerUid, incoming().companyId) || incoming().employeeUid == request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /attendanceCorrections/{correctionId} {
      allow get: if isVerifiedUser() && isValidId(correctionId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || existing().employeeUid == request.auth.uid);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid || resource.data.employeeUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(correctionId)
        && isValidAttendanceCorrection(incoming())
        && incoming().correctionId == correctionId
        && incoming().status == 'pending_manager'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isCompanyOperator(incoming().companyOwnerUid, incoming().companyId) || incoming().employeeUid == request.auth.uid);
      allow update: if isVerifiedUser()
        && isValidId(correctionId)
        && isValidAttendanceCorrection(incoming())
        && incoming().correctionId == existing().correctionId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().employeeUid == existing().employeeUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isCompanyOperator(existing().companyOwnerUid, existing().companyId)
        && !(existing().status in ['approved', 'rejected'])
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewNote', 'updatedAt']);
      allow delete: if isCompanyAdminEmail() && isValidId(correctionId);
    }

    match /leaveRequests/{leaveId} {
      allow get: if isVerifiedUser() && isValidId(leaveId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || existing().employeeUid == request.auth.uid);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid || resource.data.employeeUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(leaveId)
        && isValidLeaveRequest(incoming())
        && incoming().leaveId == leaveId
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
