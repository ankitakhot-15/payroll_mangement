    match /salaryStructures/{structureId} {
      allow get: if isVerifiedUser() && isValidId(structureId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || existing().employeeUid == request.auth.uid);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid || resource.data.employeeUid == request.auth.uid);
