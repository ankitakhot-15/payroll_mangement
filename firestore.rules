        && incoming().shiftId == existing().shiftId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isCompanyOperator(existing().companyOwnerUid, existing().companyId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'shiftType', 'startTime', 'endTime', 'breakDurationMinutes', 'gracePeriodMinutes', 'requiredWorkMinutes', 'overtimeEligible', 'isNightShift', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(shiftId) && isCompanyOperator(existing().companyOwnerUid, existing().companyId);
