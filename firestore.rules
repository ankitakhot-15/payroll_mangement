    match /attendanceDevices/{deviceId} {
      allow get: if isVerifiedUser() && isValidId(deviceId) && isCompanyOperator(existing().companyOwnerUid, existing().companyId);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid);
