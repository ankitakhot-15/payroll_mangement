    match /payrollRuns/{runId} {
      allow get: if isVerifiedUser() && isValidId(runId) && isCompanyOperator(existing().companyOwnerUid, existing().companyId);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(runId)
        && isValidPayrollRun(incoming())
        && incoming().runId == runId
        && isCompanyOperator(incoming().companyOwnerUid, incoming().companyId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(runId)
        && isValidPayrollRun(incoming())
        && incoming().runId == existing().runId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isCompanyOperator(existing().companyOwnerUid, existing().companyId)
        && (existing().status != 'locked' || isCompanyAdminEmail())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'employeeCount', 'totalGross', 'totalNet', 'totalEmployeePf', 'totalEmployerPf', 'totalEmployeeEsi', 'totalEmployerEsi', 'totalPt', 'totalTds', 'updatedAt']);
      allow delete: if isCompanyAdminEmail() && isValidId(runId);
    }

    match /payslips/{payslipId} {
      allow get: if isVerifiedUser() && isValidId(payslipId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || existing().employeeUid == request.auth.uid);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid || resource.data.employeeUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(payslipId)
        && isValidPayslip(incoming())
        && incoming().payslipId == payslipId
        && isCompanyOperator(incoming().companyOwnerUid, incoming().companyId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(payslipId)
        && isValidPayslip(incoming())
        && incoming().payslipId == existing().payslipId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().employeeUid == existing().employeeUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isCompanyOperator(existing().companyOwnerUid, existing().companyId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['runId', 'paidDays', 'unpaidDays', 'workingDays', 'presentDays', 'halfDays', 'paidLeaveDays', 'unpaidLeaveDays', 'absentDays', 'lateMarksCount', 'lateDeductionDays', 'baseMonthlyGross', 'leaveDeductionAmount', 'lateDeductionAmount', 'grossEarnings', 'employeePf', 'employerPf', 'employeeEsi', 'employerEsi', 'professionalTax', 'tds', 'loanEmi', 'overtimePay', 'netSalary', 'paymentStatus', 'updatedAt']);
      allow delete: if isCompanyAdminEmail() && isValidId(payslipId);
    }

    match /loans/{loanId} {
      allow get: if isVerifiedUser() && isValidId(loanId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || existing().employeeUid == request.auth.uid);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid || resource.data.employeeUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(loanId)
        && isValidLoan(incoming())
        && incoming().loanId == loanId
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isCompanyOperator(incoming().companyOwnerUid, incoming().companyId) || incoming().employeeUid == request.auth.uid);
      allow update: if isVerifiedUser()
        && isValidId(loanId)
        && isValidLoan(incoming())
        && incoming().loanId == existing().loanId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().employeeUid == existing().employeeUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isCompanyOperator(existing().companyOwnerUid, existing().companyId)
        && existing().status != 'settled'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'outstandingBalance', 'updatedAt']);
      allow delete: if isCompanyAdminEmail() && isValidId(loanId);
    }

    match /reimbursements/{reimbursementId} {
      allow get: if isVerifiedUser() && isValidId(reimbursementId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || existing().employeeUid == request.auth.uid);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid || resource.data.employeeUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(reimbursementId)
        && isValidReimbursement(incoming())
        && incoming().reimbursementId == reimbursementId
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isCompanyOperator(incoming().companyOwnerUid, incoming().companyId) || incoming().employeeUid == request.auth.uid);
      allow update: if isVerifiedUser()
        && isValidId(reimbursementId)
        && isValidReimbursement(incoming())
        && incoming().reimbursementId == existing().reimbursementId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().employeeUid == existing().employeeUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isCompanyOperator(existing().companyOwnerUid, existing().companyId)
        && !(existing().status in ['rejected', 'paid'])
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isCompanyAdminEmail() && isValidId(reimbursementId);
    }

    match /employeeDocuments/{docId} {
      allow get: if isVerifiedUser() && isValidId(docId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || existing().employeeUid == request.auth.uid);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid || resource.data.employeeUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(docId)
        && isValidEmployeeDocument(incoming())
        && incoming().docId == docId
        && incoming().status == 'pending_verification'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isCompanyOperator(incoming().companyOwnerUid, incoming().companyId) || incoming().employeeUid == request.auth.uid);
      allow update: if isVerifiedUser()
        && isValidId(docId)
        && isValidEmployeeDocument(incoming())
        && incoming().docId == existing().docId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().employeeUid == existing().employeeUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isCompanyOperator(existing().companyOwnerUid, existing().companyId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'expiryDate', 'documentNumber', 'reviewNote', 'fileName', 'mimeType', 'fileSizeBytes', 'fileDataUrl', 'updatedAt']))
          || (existing().employeeUid == request.auth.uid && existing().status != 'approved' && incoming().status == 'pending_verification' && incoming().diff(existing()).affectedKeys().hasOnly(['fileName', 'mimeType', 'fileSizeBytes', 'fileDataUrl', 'documentNumber', 'expiryDate', 'reviewNote', 'status', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(docId) && (isCompanyOperator(existing().companyOwnerUid, existing().companyId) || (existing().employeeUid == request.auth.uid && existing().status != 'approved'));
    }

    match /auditLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && isCompanyOperator(existing().companyOwnerUid, existing().companyId);
      allow list: if isVerifiedUser() && (isWorkspaceOperatorEmail() || resource.data.companyOwnerUid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().logId == logId
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
