        && incoming().leaveId == existing().leaveId
        && incoming().companyId == existing().companyId
        && incoming().companyOwnerUid == existing().companyOwnerUid
        && incoming().employeeUid == existing().employeeUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && !(existing().status in ['approved', 'rejected', 'cancelled'])
        && (
          (isCompanyOperator(existing().companyOwnerUid, existing().companyId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewNote', 'updatedAt']))
          || (existing().employeeUid == request.auth.uid && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isCompanyAdminEmail() && isValidId(leaveId);
